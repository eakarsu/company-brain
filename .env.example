NODE_ENV=production
PORT=3005
DATABASE_URL=postgres://company_brain_app:replace-with-secret@db.internal/company_brain
DATABASE_SSL=require
CORS_ORIGINS=https://brain.internal
OIDC_ISSUER=https://identity.internal/
OIDC_AUDIENCE=company-brain
OIDC_AUTHORIZE_URL=https://identity.internal/oauth2/authorize
OIDC_TOKEN_URL=https://identity.internal/oauth2/token
OIDC_CLIENT_ID=company-brain-web
OIDC_CLIENT_SECRET=replace-with-secret-manager-value
OIDC_REDIRECT_URI=https://brain.internal/api/v2/auth/callback
AUTH_PUBLIC_KEY_BASE64=base64-encoded-RS256-public-key
CONNECTOR_GATEWAY_BASE_URL=https://connectors.internal/v1
CONNECTOR_GATEWAY_TOKEN=replace-with-secret-manager-value
ANSWER_GATEWAY_BASE_URL=https://answers.internal/v1
ANSWER_GATEWAY_TOKEN=replace-with-secret-manager-value
CONNECTOR_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
AI_MAX_COST_CENTS=5
AI_TIMEOUT_MS=8000
RETRIEVAL_MIN_RECALL=0.80
JOB_MAX_ATTEMPTS=5
QUERY_RATE_LIMIT_PER_HOUR=60
ALLOW_SCHEMA_MIGRATION=0
ENABLE_LEGACY_DEMOS=0
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
